# Supabase
# Use the Supabase project URL and publishable/anon key in both server and browser.
SUPABASE_URL=
SUPABASE_ANON_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-only. Needed for private file storage and server-side auth operations.
SUPABASE_SERVICE_ROLE_KEY=

# Supabase PostgreSQL connection string. Used for app data and running migrations.
DATABASE_URL=

# Optional outbound notifications
RESEND_API_KEY=
RESEND_FROM="ATRO <portal@atro.ke>"
ATRO_SITE_URL=http://localhost:8080

WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0

AT_API_KEY=
AT_SENDER=

# Optional AI concierge
XAI_API_KEY=

# Optional local fallback identity before Supabase is configured
PREVIEW_AUTH_EMAIL=hello@atro.ke

# Optional WebRTC STUN override; the app has a public STUN default.
# VITE_STUN_URLS=

# Google OAuth is configured in Supabase Auth, not with app environment keys:
# enable Google and add the OAuth client ID/secret in the Supabase dashboard.
# Paystack is not integrated yet; payment keys should be added when its server-
# verified payment flow is implemented, not exposed as unvalidated placeholders.
